#!/bin/sh
# Keeps formatting and clippy clean. Enable once per clone with:
#   git config core.hooksPath .githooks
# Skip for a single commit with: git commit --no-verify
set -eu

# Docs-only and other non-Rust commits don't need a build.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -Eq '\.rs$|^Cargo\.(toml|lock)$'; then
    exit 0
fi

echo "pre-commit: cargo fmt --check"
cargo fmt --check

echo "pre-commit: cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings
