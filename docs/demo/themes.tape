# Run through docs/demo/record.sh docs/demo/themes.tape.

Output docs/images/themes.gif

Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 760
Set Padding 16
Set Framerate 15
Set PlaybackSpeed 1.0
Set Theme "Catppuccin Mocha"

Hide
Type 'export HOME="$LAZYJIRA_DEMO_HOME" TMPDIR="$LAZYJIRA_DEMO_HOME/tmp" PATH="$LAZYJIRA_DEMO_PATH"'
Enter
Type "lazyjira"
Enter
Sleep 4s
Type "q"
Type "clear && lazyjira"
Enter
Sleep 3s
Show

Sleep 1.5s
Type "S"
Sleep 1s
Tab 4
Sleep 1s
Down
Sleep 1.5s
Down
Sleep 1.5s
Down
Sleep 1.5s
Down
Sleep 1.5s
Down
Sleep 1.5s
Down
Sleep 1.5s
Up 3
Sleep 1.5s
Enter
Sleep 2s
Down
Enter
Sleep 2.5s
Escape
Sleep 1s
Tab
Sleep 2s
Tab
Sleep 2s

Hide
Type "q"
