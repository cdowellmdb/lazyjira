#!/usr/bin/env python3
"""Fake `jira` CLI that serves made-up tickets for recording the README demo.

Only covers the subcommands and output formats lazyjira calls in
src/jira_client.rs: `me` and `issue view`. Writes (comment, assign, edit, create) succeed
without changing anything. Lists, epics and moves go through Jira's REST API, which
fake_jira_rest.py serves from this file's data.
"""

import json
import re
import sys

ME = "alex.rivera@example.com"
TEAM = {
    "alex.rivera@example.com": "Alex Rivera",
    "priya.shah@example.com": "Priya Shah",
    "sam.chen@example.com": "Sam Chen",
    "jordan.lee@example.com": "Jordan Lee",
}

EPICS = [
    ("DEMO-100", "In Progress", "Checkout redesign"),
    ("DEMO-200", "In Progress", "Search performance"),
    ("DEMO-300", "To Do", "Mobile onboarding"),
]

# key, type, status, assignee email, summary, labels, epic
TICKETS = [
    ("DEMO-101", "Story", "In Progress", "alex.rivera@example.com", "Add saved payment methods to checkout", ["checkout", "frontend"], "DEMO-100"),
    ("DEMO-102", "Bug", "In Review", "alex.rivera@example.com", "Fix tax rounding for multi-currency carts", ["checkout", "billing"], "DEMO-100"),
    ("DEMO-150", "Task", "Blocked", "alex.rivera@example.com", "Rotate payment provider API keys", ["security"], "DEMO-100"),
    ("DEMO-201", "Task", "Ready for Work", "alex.rivera@example.com", "Profile slow facet queries", ["search", "perf"], "DEMO-200"),
    ("DEMO-205", "Bug", "Needs Triage", "alex.rivera@example.com", "Search returns stale results after reindex", ["search"], "DEMO-200"),
    ("DEMO-110", "Task", "Done", "alex.rivera@example.com", "Remove legacy cart endpoint", ["checkout", "cleanup"], "DEMO-100"),
    ("DEMO-103", "Story", "In Progress", "priya.shah@example.com", "Address autocomplete on shipping form", ["checkout", "frontend"], "DEMO-100"),
    ("DEMO-202", "Task", "In Progress", "priya.shah@example.com", "Cache popular search suggestions", ["search", "perf"], "DEMO-200"),
    ("DEMO-104", "Task", "Done", "priya.shah@example.com", "Checkout A/B test dashboard", ["analytics"], "DEMO-100"),
    ("DEMO-301", "Story", "To Do", "sam.chen@example.com", "Welcome carousel for first launch", ["mobile", "onboarding"], "DEMO-300"),
    ("DEMO-302", "Bug", "In Review", "sam.chen@example.com", "Push permission prompt shows twice on Android", ["mobile", "android"], "DEMO-300"),
    ("DEMO-203", "Task", "Blocked", "sam.chen@example.com", "Upgrade search cluster", ["search", "infra"], "DEMO-200"),
    ("DEMO-204", "Story", "In Progress", "jordan.lee@example.com", "Typo-tolerant product search", ["search"], "DEMO-200"),
    ("DEMO-303", "Task", "Ready for Work", "jordan.lee@example.com", "Track onboarding funnel events", ["mobile", "analytics"], "DEMO-300"),
    ("DEMO-105", "Task", "Done", "jordan.lee@example.com", "Load test checkout at peak traffic", ["checkout", "perf"], "DEMO-100"),
    ("DEMO-106", "Bug", "Needs Triage", None, "Coupon field accepts expired codes", ["checkout"], "DEMO-100"),
    ("DEMO-206", "Task", "To Do", None, "Document search ranking signals", ["search", "docs"], "DEMO-200"),
    ("DEMO-304", "Task", "Needs Triage", None, "Localize onboarding copy for es-MX", ["mobile", "i18n"], "DEMO-300"),
    ("DEMO-400", "Bug", "Needs Triage", None, "Flaky timeout in nightly e2e suite", ["ci"], None),
]

# key, status, assignee email, summary, labels, parent. DEMO-114 sits in another person's
# group than its parent, so its summary leads with the parent's key.
SUBTASKS = [
    ("DEMO-111", "In Progress", "alex.rivera@example.com", "Migrate stored cards to the new vault", ["checkout"], "DEMO-101"),
    ("DEMO-112", "To Do", "alex.rivera@example.com", "Add card tokenization endpoint", ["checkout", "backend"], "DEMO-101"),
    ("DEMO-113", "In Progress", "priya.shah@example.com", "Wire the address lookup API", ["checkout", "frontend"], "DEMO-103"),
    ("DEMO-114", "In Progress", "sam.chen@example.com", "Reproduce the rounding bug on staging", ["billing"], "DEMO-102"),
]

# The id of the Epic Link custom field. record.sh puts it in the demo's jira-cli config
# (`epic.link`), which is where lazyjira reads it from.
EPIC_LINK_FIELD = "customfield_10857"


def ticket_dict(row, parent=None):
    key, issue_type, status, assignee, summary, labels, epic = row
    return {
        "key": key,
        "type": issue_type,
        "status": status,
        "assignee": assignee,
        "summary": summary,
        "labels": labels,
        "epic": epic,
        "parent": parent,
    }


def all_tickets():
    subtasks = [
        ticket_dict((key, "Sub-task", status, assignee, summary, labels, None), parent)
        for key, status, assignee, summary, labels, parent in SUBTASKS
    ]
    return [ticket_dict(row) for row in TICKETS] + subtasks


def epic_tickets():
    return [
        ticket_dict((key, "Epic", status, None, summary, [], None))
        for key, status, summary in EPICS
    ]


def values(group):
    return [v.strip().strip('"').lower() for v in group.split(",") if v.strip()]


def matches(ticket, clause):
    clause = clause.strip()
    lower = clause.lower()

    m = re.fullmatch(r'assignee\s*=\s*"?([^"]+?)"?', clause, re.I)
    if m:
        value = m.group(1)
        email = ME if value.lower() == "currentuser()" else value
        return ticket["assignee"] == email
    m = re.fullmatch(r"assignee\s+in\s*\((.*)\)", clause, re.I)
    if m:
        return (ticket["assignee"] or "").lower() in values(m.group(1))
    if re.fullmatch(r"assignee\s+is\s+empty", lower):
        return ticket["assignee"] is None

    m = re.fullmatch(r"key\s+in\s*\((.*)\)", clause, re.I)
    if m:
        return ticket["key"].lower() in values(m.group(1))
    m = re.fullmatch(r"parent\s+in\s*\((.*)\)", clause, re.I)
    if m:
        return (ticket["parent"] or "").lower() in values(m.group(1))
    m = re.fullmatch(r'"epic link"\s+in\s*\((.*)\)', clause, re.I)
    if m:
        return (ticket["epic"] or "").lower() in values(m.group(1))
    if re.fullmatch(r"issuetype\s+in\s+subTaskIssueTypes\(\)", clause, re.I):
        return ticket["type"] == "Sub-task"

    m = re.fullmatch(r"status\s+in\s*\((.*)\)", clause, re.I)
    if m:
        statuses = [s.strip().strip('"').lower() for s in m.group(1).split(",")]
        return ticket["status"].lower() in statuses
    m = re.fullmatch(r'status\s*=\s*"?([^"]+?)"?', clause, re.I)
    if m:
        return ticket["status"].lower() == m.group(1).lower()

    m = re.fullmatch(r'(?:type|issuetype)\s*=\s*"?([^"]+?)"?', clause, re.I)
    if m:
        return ticket["type"].lower() == m.group(1).lower()
    m = re.fullmatch(r'labels\s*=\s*"?([^"]+?)"?', clause, re.I)
    if m:
        return m.group(1) in ticket["labels"]
    m = re.fullmatch(r'(?:"epic link"|parent)\s*=\s*"?([^"]+?)"?', clause, re.I)
    if m:
        return ticket["epic"] == m.group(1).upper()

    # Anything else ("Assigned Teams", updated/created windows, priority) matches everything.
    return True


def split_top(expr, word):
    """Splits `expr` on the keyword `word`, outside parentheses and quotes."""
    pattern = re.compile(rf"\s+{word}\s+", re.I)
    parts, depth, quoted, start, i = [], 0, False, 0, 0
    while i < len(expr):
        c = expr[i]
        if c == '"':
            quoted = not quoted
        elif not quoted and c == "(":
            depth += 1
        elif not quoted and c == ")":
            depth -= 1
        elif not quoted and depth == 0 and c.isspace():
            m = pattern.match(expr, i)
            if m:
                parts.append(expr[start:i])
                start = i = m.end()
                continue
        i += 1
    parts.append(expr[start:])
    return parts


def evaluate(ticket, expr):
    """A small JQL evaluator: OR, AND and parentheses over the clauses `matches` knows."""
    expr = expr.strip()
    for word, combine in (("or", any), ("and", all)):
        parts = split_top(expr, word)
        if len(parts) > 1:
            return combine(evaluate(ticket, part) for part in parts)
    if expr.startswith("(") and expr.endswith(")"):
        return evaluate(ticket, expr[1:-1])
    return matches(ticket, expr)


def run_query(jql):
    jql = re.split(r"\border\s+by\b", jql, flags=re.I)[0]
    # Epics are only found by asking for the type, so the epic search can list them without
    # them turning up, unassigned, in every other list.
    asks_for_epics = re.search(r'issuetype\s*=\s*"?epic\b', jql, re.I)
    issues = all_tickets() + (epic_tickets() if asks_for_epics else [])
    return [t for t in issues if evaluate(t, jql)]


def person(email):
    if not email:
        return None
    return {"displayName": TEAM[email], "emailAddress": email}


def base_fields(t):
    """The fields a list search and `issue view --raw` both return, as Jira shapes them."""
    number = int(t["key"].split("-")[1])
    return {
        "summary": t["summary"],
        "status": {"name": t["status"]},
        "assignee": person(t["assignee"]),
        "labels": t["labels"],
        "updated": f"2026-09-{number % 27 + 1:02d}T10:00:00.000+0000",
        "issuetype": {"name": t["type"], "subtask": t["type"] == "Sub-task"},
        "parent": {"key": t["parent"]} if t["parent"] else None,
        EPIC_LINK_FIELD: t["epic"],
    }


def issue_payload(t):
    """One issue as `issue view --raw` shows it: every field, and the changelog."""
    reporter = "priya.shah@example.com" if t["assignee"] != "priya.shah@example.com" else ME
    histories = [
        {
            "created": "2026-09-15T09:12:00.000+0000",
            "author": person(reporter),
            "items": [{"field": "status", "fromString": "Needs Triage", "toString": "Ready for Work"}],
        }
    ]
    if t["assignee"]:
        histories.append(
            {
                "created": "2026-09-16T16:40:00.000+0000",
                "author": person(reporter),
                "items": [{"field": "assignee", "fromString": "", "toString": TEAM[t["assignee"]]}],
            }
        )
    if t["status"] not in ("Needs Triage", "Ready for Work", "To Do"):
        histories.append(
            {
                "created": "2026-09-18T10:05:00.000+0000",
                "author": person(t["assignee"] or reporter),
                "items": [{"field": "status", "fromString": "Ready for Work", "toString": t["status"]}],
            }
        )
    comments = [
        {
            "created": "2026-09-22T13:30:00.000+0000",
            "author": person(reporter),
            "body": "Looping in design for the edge cases before we ship. (/) Spec is approved.",
        }
    ]
    if t["assignee"]:
        comments.append(
            {
                "created": "2026-09-24T17:05:00.000+0000",
                "author": person(t["assignee"]),
                "body": "Draft PR is up. *Tests pass locally*; waiting on {{staging}} to deploy.",
            }
        )
    return {
        "key": t["key"],
        "fields": {
            **base_fields(t),
            "reporter": person(reporter),
            "description": (
                "h2. Context\n"
                f"{t['summary']}. Customers hit this during *peak checkout traffic*; "
                "see the [incident review|https://example.com/wiki/INC-42] for details.\n\n"
                "h3. Acceptance criteria\n"
                "# Behavior is covered by automated tests\n"
                "# Metrics dashboard shows _no regressions_\n"
                "# Docs updated if user-facing\n\n"
                "h3. Rollout\n"
                "||Stage||Traffic||Owner||\n"
                "|Canary|5%|[~priya.shah]|\n"
                "|General|100%|[~alex.rivera]|\n\n"
                "{code:bash}\n"
                "make test && make deploy ENV=staging\n"
                "{code}\n\n"
                "(!) Coordinate with the {{payments}} team before enabling in production."
            ),
            "comment": {"comments": comments},
        },
        "changelog": {"histories": histories},
    }


def issue_view(key):
    rows = [t for t in all_tickets() if t["key"] == key]
    if not rows:
        sys.exit(f"issue {key} not found")
    print(json.dumps(issue_payload(rows[0])))


def main(args):
    if args == ["me"]:
        print(ME)
    elif args[:2] == ["issue", "view"] and len(args) >= 3:
        issue_view(args[2])
    elif args[:2] == ["issue", "create"]:
        print("Issue DEMO-500 created")
    elif args[:2] in (["issue", "assign"], ["issue", "edit"], ["issue", "comment"]):
        print("ok")
    else:
        sys.exit(f"demo jira: unsupported command: {' '.join(args)}")


if __name__ == "__main__":
    main(sys.argv[1:])
